{
  "name": "pwd-week8-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-data.ts",
    "start": "node dist/server.js",
    "test": "jest --runInBand && npm run test:sql",
    "test:watch": "jest --watch --runInBand",
    "test:sql": "node --import tsx --test tests/schema.postgres.ts",
    "db:check": "tsx scripts/check-db.ts",
    "change-user-type": "tsx scripts/change-user-type.ts",
    "test:live": "tsx scripts/verify-live.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "auth:setup-naver": "tsx scripts/setup-naver-oidc.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "17.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@electric-sql/pglite": "0.5.14",
    "@types/emscripten": "1.41.6"
  },
  "description": "Week 8 FoodMap: Supabase Auth, administrator API and transactional submissions"
}
